{
  "name": "page-title",
  "version": "1.0.0",
  "description": "PageTitle component for Quartz - displays the site title with a random font on every load",
  "type": "module",
  "license": "MIT",
  "author": "TJ2005",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./components": "./components/index.js",
    "./package.json": "./package.json"
  },
  "quartz": {
    "name": "page-title",
    "displayName": "Page Title",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "PageTitle": {
        "displayName": "Page Title",
        "defaultPosition": "left",
        "defaultPriority": 10
      }
    }
  }
}